{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "git *": "allow",
      "npm run *": "allow",
      "pnpm run *": "allow",
      "bun run *": "allow",
      "node *": "allow",
      "python *": "allow",
      "eslint *": "allow",
      "prettier *": "allow",
      "test *": "allow",
      "ls *": "allow",
      "cat *": "allow",
      "find *": "allow",
      "grep *": "allow",
      "which *": "allow",
      "mkdir *": "allow",
      "touch *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "wc *": "allow",
      "pwd": "allow",
      "cd *": "allow",
      "* --version": "allow",
      "* --help *": "allow",
      "npm install *": "deny",
      "npm i *": "deny",
      "pnpm install *": "deny",
      "pnpm add *": "deny",
      "pnpm i *": "deny",
      "bun install *": "deny",
      "bun add *": "deny",
      "yarn *": "deny",
      "deno install *": "deny",
      "deno add *": "deny",
      "sudo *": "deny",
      "chmod *": "deny",
      "chown *": "deny",
      "rm /* *": "deny",
      "rm /Users *": "deny",
      "rm /etc *": "deny",
      "rm /var *": "deny",
      "rm /tmp *": "deny",
      "rm /bin *": "deny",
      "rm /usr *": "deny",
      "rm /Library *": "deny",
      "rm /System *": "deny"
    },
    "task": {
      "*": "ask",
      "explore": "allow",
      "plan": "allow"
    }
  },
  "agent": {
    "build": {
      "description": "Full development work with all tools enabled. Runs autonomously following permission rules.",
      "mode": "primary",
      "permission": {
        "bash": "allow",
        "edit": "allow",
        "read": "allow",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "webfetch": "allow",
        "websearch": "allow",
        "codesearch": "allow",
        "task": {
          "*": "allow"
        }
      }
    }
  },
  "instructions": [
    "AGENTS.md"
  ]
}
